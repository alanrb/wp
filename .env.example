# Copy to .env and adjust. Leave WP_IMAGE_TAG unset to track the latest WordPress.
WP_IMAGE_TAG=php8.3-apache

# PHP tag for the wp-cli container. `php -l` and Theme Check — the two
# PHP-version-sensitive gates — both run there, so PHP_TAG MUST be kept
# consistent with the PHP part of WP_IMAGE_TAG. Leave them out of step and the
# gate validates a different PHP version from the one the site serves, so a
# theme's `Requires PHP` floor is never actually exercised. Walking the NFR4
# matrix means changing both together, e.g.
#   WP_IMAGE_TAG=6.8-php8.2-apache
#   PHP_TAG=php8.2
PHP_TAG=php8.3

WP_PORT=8080
WP_URL=http://localhost:8080
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=dev@example.com
